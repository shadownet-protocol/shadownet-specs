{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sh4dow.org/schemas/v0/credentials/affiliation-credential.schema.json",
  "title": "Shadownet AffiliationCredential (JWT payload)",
  "description": "Payload of an AffiliationCredential VC JWT (typ=vc+jwt) — asserts that a Subject is affiliated with an organization. Issuer MUST be the org's did:web or a delegated did:web SCA (per the org's DID document `shadownet:delegatedIssuers`). See RFC-0003 §AffiliationCredential.",
  "type": "object",
  "required": ["iss", "sub", "iat", "exp", "jti", "shadownet:v", "vc"],
  "properties": {
    "iss":  { "type": "string", "pattern": "^did:web:" },
    "sub":  { "type": "string", "pattern": "^did:" },
    "iat":  { "type": "integer", "minimum": 0 },
    "exp":  { "type": "integer", "minimum": 0 },
    "jti":  { "type": "string", "format": "uri" },
    "shadownet:v": { "const": "0.1" },

    "vc": {
      "type": "object",
      "required": ["@context", "type", "credentialSubject"],
      "properties": {
        "@context": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "contains": { "const": "https://www.w3.org/ns/credentials/v2" }
        },
        "type": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "ShadownetAffiliationCredential" },
          "allOf": [
            { "contains": { "const": "VerifiableCredential" } }
          ]
        },
        "credentialSubject": {
          "type": "object",
          "required": ["id", "affiliation"],
          "properties": {
            "id":          { "type": "string", "pattern": "^did:" },
            "affiliation": { "type": "string", "pattern": "^did:web:" },
            "role":        { "type": "string" },
            "groups": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "credentialStatus": {
          "type": "object",
          "required": ["type", "statusListIndex", "statusListCredential"],
          "properties": {
            "type":                 { "const": "BitstringStatusListEntry" },
            "statusListIndex":      { "type": "string", "pattern": "^[0-9]+$" },
            "statusListCredential": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
